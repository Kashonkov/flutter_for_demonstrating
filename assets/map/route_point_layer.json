{
  "id": "route-points",
  "type": "circle",
  "source": "route-source",
  "filter": [
    "has", "type"
  ],
  "paint": {
    "circle-color": [
      "case",
      ["boolean", ["feature-state", "selected"], false], "#000000",
      ["match", ["to-string", ["get", "type"]],
        "destination", "rgba(0,0,0,0)",
        "incident", "rgba(0,0,0,0)",
        "waypoint", "#FFFFFF",
        "current", "#00C63C",
        "#FFFFFF"
      ]
    ],
    "circle-radius": [
      "match",
      ["to-string", ["get", "type"]],
      "incident", 8,
      "waypoint", 3,
      "current", 5,
      2.5
    ],
    "circle-stroke-width": 1,
    "circle-stroke-color": [
      "case",
      ["boolean", ["feature-state", "selected"], false], "#000000",
      ["match", ["to-string", ["get", "type"]],
        "destination", "rgba(0,0,0,0)",
        "incident", "rgba(0,0,0,0)",
        "waypoint", "#000000",
        "current", "#00C63C",
        "#000000"
      ]
    ],
    "circle-stroke-opacity": [
      "case",
      ["boolean", ["feature-state", "selected"], false],  1,
      ["match", ["to-string", ["get", "type"]],
        "destination", 0,
        "incident", 0,
        1
      ]
    ]
  }
}